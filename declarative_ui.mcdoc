use ::java::util::text::Text
use ::java::data::item_modifier::ItemModifier
use ::java::world::item::ItemStackTemplate
use ::java::data::predicate::Predicate

dispatch minecraft:resource[declarative_ui:container] to struct DeclaredContainer {
    size: int
}

enum(string) ClickType {
    MOUSE_LEFT = "mouse_left",
    MOUSE_RIGHT = "mouse_right",
    MOUSE_LEFT_SHIFT = "mouse_left_shift",
    MOUSE_RIGHT_SHIFT = "mouse_right_shift",
    NUM_KEY_1 = "num_key_1",
    NUM_KEY_2 = "num_key_2",
    NUM_KEY_3 = "num_key_3",
    NUM_KEY_4 = "num_key_4",
    NUM_KEY_5 = "num_key_5",
    NUM_KEY_6 = "num_key_6",
    NUM_KEY_7 = "num_key_7",
    NUM_KEY_8 = "num_key_8",
    NUM_KEY_9 = "num_key_9",
    MOUSE_MIDDLE = "mouse_middle",
    DROP = "drop",
    CTRL_DROP = "ctrl_drop",
    MOUSE_LEFT_OUTSIDE = "mouse_left_outside",
    MOUSE_RIGHT_OUTSIDE = "mouse_right_outside",
    MOUSE_LEFT_DRAG_START = "mouse_left_drag_start",
    MOUSE_RIGHT_DRAG_START = "mouse_right_drag_start",
    MOUSE_MIDDLE_DRAG_START = "mouse_middle_drag_start",
    MOUSE_LEFT_DRAG_ADD = "mouse_left_drag_add",
    MOUSE_RIGHT_DRAG_ADD = "mouse_right_drag_add",
    MOUSE_MIDDLE_DRAG_ADD = "mouse_middle_drag_add",
    MOUSE_LEFT_DRAG_END = "mouse_left_drag_end",
    MOUSE_RIGHT_DRAG_END = "mouse_right_drag_end",
    MOUSE_MIDDLE_DRAG_END = "mouse_middle_drag_end",
    MOUSE_DOUBLE_CLICK = "mouse_double_click",
    UNKNOWN = "unknown",
    OFFHAND_SWAP = "offhand_swap"
}

enum(string) ActionType {
    PICKUP = "pickup",
    QUICK_MOVE = "quick_move",
    SWAP = "swap",
    CLONE = "clone",
    THROW = "throw",
    QUICK_CRAFT = "quick_craft",
    PICKUP_ALL = "pickup_all"
}

enum(int) PermissionLevel {
    ALL = 0,
    MODERATORS = 1,
    GAMEMASTERS = 2,
    ADMINS = 3,
    OWNERS = 4
}

enum(string) ClickActionType {
    FUNCTION = "declarative_ui:function",
    OPEN_MENU = "declarative_ui:open_menu",
    /// The menu will be closed.
    CLOSE_MENU = "declarative_ui:close_menu",
    /// The menu will be refreshed, re-rendering all slots.
    REFRESH_MENU = "declarative_ui:refresh_menu",
    /// Only the title will be re-evaluated.
    REFRESH_MENU_TITLE = "declarative_ui:refresh_menu_title"
}

struct ClickAction {
	type: #[id] ClickActionType,
    ...declarative_ui:click_action_type[[type]]
}

dispatch declarative_ui:click_action_type[declarative_ui:function] to struct {
    /// The specified function will be executed.
    function: #[id="function"] string
}

dispatch declarative_ui:click_action_type[declarative_ui:open_menu] to struct {
    /// The specified menu will be opened.
    menu: #[id="declarative_ui:menu"] string
}

struct ClickEvent {
    actions?: (ClickAction | [ClickAction]),
    /// If specified, the click event will only be triggered for the specified click type. If not specified, the click event will be triggered for all click types.
    click_type?: ClickType,
    /// If specified, the click event will only be triggered for the specified action type. If not specified, the click event will be triggered for all action types.
    action_type?: ActionType
}

struct SlotProvider {
	type: #[id] SlotProviderType,
	...declarative_ui:slot_provider_type[[type]],
}

enum(string) SlotProviderType {
    SIMPLE = "declarative_ui:simple",
    TAG = "declarative_ui:tag",
    ANIMATED = "declarative_ui:animated"
}

dispatch declarative_ui:slot_provider_type[declarative_ui:simple] to struct SimpleSlotProvider {
    item?: ItemStackTemplate,
    item_modifier?: (#[id="item_modifier"] string | ItemModifier)
}

dispatch declarative_ui:slot_provider_type[declarative_ui:tag] to struct TagSlotProvider {
    tag: #[id(registry="item",tags="implicit")] string,
    /// The duration in ticks that each item will be displayed for before switching to the next one.
    interval: int,
    /// Defaults to `false`. If `true`, the tag will be displayed in a random order instead of sequentially.
    random?: boolean
}

dispatch declarative_ui:slot_provider_type[declarative_ui:animated] to struct AnimatedSlotProvider {
    providers: [(#[id="item"] string | SlotProvider)],
    /// The duration in ticks that each provider will be displayed for before switching to the next one.
    interval: int,
    /// Defaults to `false`. If `true`, the providers will be displayed in a random order instead of sequentially.
    random?: boolean
}

struct DeclaredSlot {
    index: int,
    provider: SlotProvider,
    click_event?: (ClickEvent | [ClickEvent])
}

struct ContainerProvider {
	type: #[id] ContainerProviderType,
	...declarative_ui:container_provider_type[[type]],
}

enum(string) ContainerProviderType {
    CONTAINER_ENTITY = "declarative_ui:container_entity",
    ENDER_CHEST = "declarative_ui:ender_chest",
    PLAYER_CONTAINER = "declarative_ui:player_container",
    PLAYER_INVENTORY = "declarative_ui:player_inventory"
}

dispatch declarative_ui:container_provider_type[declarative_ui:player_container] to struct PlayerContainerProvider {
    container: #[id="declarative_ui:container"] string
}

struct DeclaredContainerProvider {
    provider: ContainerProvider,
    redirects: [struct {
        slot: int,
        container_slot: int,
        /// Overrides the view_only property of the declared container provider for this specific redirect.
        view_only?: boolean
    }],
    /// Defaults to `false`. If `true`, the container provided by this provider will only be used for rendering and will not be interactable.
    view_only?: boolean
}

enum(string) MenuType {
    SIMPLE = "declarative_ui:simple"
}

dispatch declarative_ui:menu_type[declarative_ui:simple] to struct SimpleMenu {
    /// Defaults to translation key `container.<menu_id>`. If specified, this text will be used as the menu's title instead of the default translation key.
    title?: Text,
    menu_type: #[id="menu"] string,
    /// Defaults to `false`. If `true`, the menu will extend into the player's inventory, allowing for manipulation of player inventory slots.
    manipulate_player_slots?: boolean,
    /// Defaults to `false`. If `true`, the player's inventory will be locked while the menu is open, preventing any interaction with it.
    lock_player_inventory?: boolean,
    slots: [DeclaredSlot],
    containers?: [DeclaredContainerProvider],
    close_actions?: (ClickAction | [ClickAction])
}

dispatch minecraft:resource[declarative_ui:menu] to struct DeclaredMenu {
    type: #[id] MenuType,
    ...declarative_ui:menu_type[[type]]
}

struct CommandArgumentProvider {
	type: #[id="command_argument_type"] string,
    ...declarative_ui:command_argument_type[[type]]
}

dispatch declarative_ui:command_argument_type[brigadier:float] to struct {
    /// Defaults to `-Float.MAX_VALUE`
    min?: float,
    /// Defaults to `Float.MAX_VALUE`
    max?: float
}

dispatch declarative_ui:command_argument_type[brigadier:double] to struct {
    /// Defaults to `-Double.MAX_VALUE`
    min?: double,
    /// Defaults to `Double.MAX_VALUE`
    max?: double
}

dispatch declarative_ui:command_argument_type[brigadier:integer] to struct {
    /// Defaults to `Integer.MIN_VALUE`
    min?: int,
    /// Defaults to `Integer.MAX_VALUE`
    max?: int
}

dispatch declarative_ui:command_argument_type[brigadier:long] to struct {
    /// Defaults to `Long.MIN_VALUE`
    min?: long,
    /// Defaults to `Long.MAX_VALUE`
    max?: long
}

dispatch declarative_ui:command_argument_type[brigadier:string] to struct {
    variant: enum(string) {
        SINGLE_WORD = "single_word",
        QUOTABLE_PHRASE = "quotable_phrase",
        GREEDY_PHRASE = "greedy_phrase"
    }
}

dispatch declarative_ui:command_argument_type[entity] to struct {
    single: boolean,
    players: boolean
}

dispatch declarative_ui:command_argument_type[score_holder] to struct {
    multiple: boolean
}

dispatch declarative_ui:command_argument_type[time] to struct {
    /// Defaults to 0
    min?: int
}

struct RegistryArgument {
    registry: #[id="registry"] string
}

dispatch declarative_ui:command_argument_type[resource_or_tag] to RegistryArgument
dispatch declarative_ui:command_argument_type[resource_or_tag_key] to RegistryArgument
dispatch declarative_ui:command_argument_type[resource] to RegistryArgument
dispatch declarative_ui:command_argument_type[resource_key] to RegistryArgument
dispatch declarative_ui:command_argument_type[resource_selector] to RegistryArgument

enum(string) CommandActionType {
    FUNCTION = "declarative_ui:function",
    OPEN_MENU = "declarative_ui:open_menu"
}

struct CommandAction {
    type: #[id] CommandActionType,
    ...declarative_ui:command_action_type[[type]]
}

dispatch declarative_ui:command_action_type[declarative_ui:function] to struct {
    /// The specified function will be executed with every argument provided by this node and its parent nodes as parameters.
    function: #[id="function"] string
}

dispatch declarative_ui:command_action_type[declarative_ui:open_menu] to struct {
    /// The specified menu will be opened.
    menu: #[id="declarative_ui:menu"] string
}

struct DeclaredNode {
    name: string,
    argument_type?: CommandArgumentProvider,
    action?: CommandAction,
    nodes?: (DeclaredNode | [DeclaredNode]),
    permission_level?: (PermissionLevel | int)
}

dispatch minecraft:resource[declarative_ui:command] to struct DeclaredCommand {
    action?: CommandAction,
    nodes?: (DeclaredNode | [DeclaredNode]),
    permission_level?: (PermissionLevel | int)
}